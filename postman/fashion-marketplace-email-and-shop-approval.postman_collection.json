{
  "info": {
    "name": "Fashion Marketplace - Email Verification and Shop Approval",
    "description": "Six-digit email verification and ADMIN-only shop review APIs. Configure SMTP and apply the email-verification migration before sending messages.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "verificationCode", "value": "" },
    { "key": "customerEmail", "value": "your-inbox@example.com" },
    { "key": "shopOwnerEmail", "value": "pending@fashionmarket.test" },
    { "key": "shopOwnerPassword", "value": "ShopPass1!" },
    { "key": "shopOwnerToken", "value": "" },
    { "key": "adminEmail", "value": "admin@fashionmarket.test" },
    { "key": "adminPassword", "value": "AdminPass1!" },
    { "key": "shopId", "value": "3" }
  ],
  "item": [
    {
      "name": "Email verification",
      "item": [
        {
          "name": "Register customer and send verification email",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"phone\": \"+1 555 0100\",\n  \"password\": \"FashionPass1!\",\n  \"passwordConfirmation\": \"FashionPass1!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Resend verification email",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/verification-email"
          }
        },
        {
          "name": "Verify email with code",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"code\": \"{{verificationCode}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/verify-email"
          }
        },
        {
          "name": "Login as verified customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"FashionPass1!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Prepare seeded pending shop contact email",
      "item": [
        {
          "name": "Login as pending shop owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data.accessToken) {",
                  "  pm.collectionVariables.set('shopOwnerToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{shopOwnerEmail}}\",\n  \"password\": \"{{shopOwnerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Set shop decision email recipient",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{shopOwnerToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your-inbox@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/shop-owner/shop"
          }
        }
      ]
    },
    {
      "name": "Admin shop approvals",
      "item": [
        {
          "name": "Admin login (required before shop requests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "List pending shops",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/shops?status=PENDING&page=1&limit=10"
          }
        },
        {
          "name": "Approve pending shop",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/admin/shops/{{shopId}}/decision"
          }
        },
        {
          "name": "Reject pending shop",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"REJECTED\",\n  \"rejectionReason\": \"Please provide the missing registration document.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/admin/shops/{{shopId}}/decision"
          }
        },
        {
          "name": "Retry saved decision email",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/shops/{{shopId}}/decision-email"
          }
        }
      ]
    }
  ]
}
