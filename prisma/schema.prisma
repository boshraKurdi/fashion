generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  SHOP_OWNER
  ADMIN

  @@map("role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("status")
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ShopBranchStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum OfferDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
  REJECTED
}

enum ShopSubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum OrderPaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SubscriptionPlanDurationUnit {
  DAY
  MONTH
  YEAR
}

enum SubscriptionPlanStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  name              String     @db.VarChar(150)
  email             String     @unique(map: "email") @db.VarChar(190)
  phone             String?    @db.VarChar(30)
  password          String     @db.VarChar(255)
  role              UserRole   @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  email_verified_at DateTime?  @db.DateTime(0)
  created_at        DateTime?  @default(now()) @db.Timestamp(0)
  updated_at        DateTime?  @default(now()) @updatedAt @db.Timestamp(0)

  shops        Shop[]
  favorites    Favorite[]
  carts        Cart[]
  addresses    Address[]
  orders       Order[]
  reviews      ShopReview[]

  @@map("users")
}

model Shop {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  owner_id        BigInt       @db.UnsignedBigInt
  name            String       @db.VarChar(180)
  description     String?      @db.Text
  logo            String?      @db.VarChar(500)
  cover_image     String?      @db.VarChar(500)
  phone           String?      @db.VarChar(30)
  email           String?      @db.VarChar(190)
  status          ShopStatus   @default(PENDING)
  rejection_reason String?     @db.Text
  approved_at     DateTime?    @db.DateTime(0)
  created_at      DateTime?    @default(now()) @db.Timestamp(0)
  updated_at      DateTime?    @default(now()) @updatedAt @db.Timestamp(0)

  owner             User                @relation(fields: [owner_id], references: [id])
  branches          ShopBranch[]
  products          Product[]
  offers            Offer[]
  orders            Order[]
  reviews           ShopReview[]
  subscriptions     ShopSubscription[]

  @@map("shops")
}

model ShopBranch {
  id         BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  shop_id    BigInt            @db.UnsignedBigInt
  name       String            @db.VarChar(150)
  address    String            @db.VarChar(255)
  phone      String?           @db.VarChar(30)
  city       String            @db.VarChar(100)
  area       String?           @db.VarChar(100)
  latitude   Decimal?          @db.Decimal(10,7)
  longitude  Decimal?          @db.Decimal(10,7)
  status     ShopBranchStatus  @default(ACTIVE)
  created_at DateTime?         @default(now()) @db.Timestamp(0)
  updated_at DateTime?         @default(now()) @updatedAt @db.Timestamp(0)

  shop Shop @relation(fields: [shop_id], references: [id])

  @@map("shop_branches")
}

model Category {
  id         BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  parent_id  BigInt?     @db.UnsignedBigInt
  name       String      @db.VarChar(120)
  slug       String      @unique @db.VarChar(150)
  image      String?     @db.VarChar(500)
  status     Int         @default(1)
  created_at DateTime?   @default(now()) @db.Timestamp(0)
  updated_at DateTime?   @default(now()) @updatedAt @db.Timestamp(0)

  parent   Category?  @relation("CategoryParent", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@map("categories")
}

model Brand {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @unique @db.VarChar(120)
  logo       String?   @db.VarChar(500)
  status     Int       @default(1)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamp(0)

  products Product[]

  @@map("brands")
}

model Product {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  shop_id     BigInt        @db.UnsignedBigInt
  category_id BigInt        @db.UnsignedBigInt
  brand_id    BigInt?       @db.UnsignedBigInt
  name        String        @db.VarChar(200)
  description String?       @db.Text
  price       Decimal       @db.Decimal(12,2)
  sale_price  Decimal?      @db.Decimal(12,2)
  status      ProductStatus @default(DRAFT)
  created_at  DateTime?     @default(now()) @db.Timestamp(0)
  updated_at  DateTime?     @default(now()) @updatedAt @db.Timestamp(0)

  shop       Shop            @relation(fields: [shop_id], references: [id])
  category   Category        @relation(fields: [category_id], references: [id])
  brand      Brand?          @relation(fields: [brand_id], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  favorites  Favorite[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  offerProducts OfferProduct[]

  @@map("products")
}

model ProductImage {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_id BigInt    @db.UnsignedBigInt
  image      String    @db.VarChar(500)
  is_primary Boolean   @default(false)
  sort_order Int       @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)

  product Product @relation(fields: [product_id], references: [id])

  @@map("product_images")
}

model Color {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @unique @db.VarChar(80)
  hex_code   String?   @db.Char(7)
  created_at DateTime? @default(now()) @db.Timestamp(0)

  variants ProductVariant[]

  @@map("colors")
}

model Size {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(40)
  type       String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(0)

  variants ProductVariant[]

  @@unique([name, type], map: "uq_sizes_name_type")
  @@map("sizes")
}

model ProductVariant {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id BigInt   @db.UnsignedBigInt
  color_id   BigInt?  @db.UnsignedBigInt
  size_id    BigInt?  @db.UnsignedBigInt
  price      Decimal? @db.Decimal(12,2)
  sale_price Decimal? @db.Decimal(12,2)
  sku        String?  @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamp(0)

  product Product @relation(fields: [product_id], references: [id])
  color   Color?   @relation(fields: [color_id], references: [id])
  size    Size?    @relation(fields: [size_id], references: [id])
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([sku], map: "uq_variants_sku")
  @@map("product_variants")
}

model Offer {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  shop_id         BigInt            @db.UnsignedBigInt
  title           String            @db.VarChar(180)
  description     String?           @db.Text
  image           String?           @db.VarChar(500)
  discount_type   OfferDiscountType
  discount_value  Decimal           @db.Decimal(12,2)
  start_at        DateTime          @db.DateTime(0)
  end_at          DateTime          @db.DateTime(0)
  status          OfferStatus       @default(DRAFT)
  created_at      DateTime?         @default(now()) @db.Timestamp(0)
  updated_at      DateTime?         @default(now()) @updatedAt @db.Timestamp(0)

  shop Shop @relation(fields: [shop_id], references: [id])
  offerProducts OfferProduct[]

  @@map("offers")
}

model OfferProduct {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  offer_id   BigInt    @db.UnsignedBigInt
  product_id BigInt    @db.UnsignedBigInt
  created_at DateTime? @default(now()) @db.Timestamp(0)

  offer   Offer   @relation(fields: [offer_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@unique([offer_id, product_id], map: "uq_offer_product")
  @@map("offer_products")
}

model Favorite {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  product_id BigInt    @db.UnsignedBigInt
  created_at DateTime? @default(now()) @db.Timestamp(0)

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@unique([user_id, product_id], map: "uq_favorites_user_product")
  @@map("favorites")
}

model Cart {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  status     CartStatus @default(ACTIVE)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamp(0)

  user User @relation(fields: [user_id], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  cart_id    BigInt    @db.UnsignedBigInt
  product_id BigInt    @db.UnsignedBigInt
  variant_id BigInt?   @db.UnsignedBigInt
  quantity   Int       @default(1)
  price      Decimal   @db.Decimal(12,2)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamp(0)

  cart    Cart            @relation(fields: [cart_id], references: [id])
  product Product         @relation(fields: [product_id], references: [id])
  variant ProductVariant? @relation(fields: [variant_id], references: [id])

  @@map("cart_items")
}

model Address {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt    @db.UnsignedBigInt
  title           String?   @db.VarChar(80)
  recipient_name  String    @db.VarChar(150)
  phone           String    @db.VarChar(30)
  city            String    @db.VarChar(100)
  area            String?   @db.VarChar(100)
  address         String    @db.Text
  notes           String?   @db.Text
  is_default      Boolean   @default(false)
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  updated_at      DateTime? @default(now()) @updatedAt @db.Timestamp(0)

  user User @relation(fields: [user_id], references: [id])

  @@map("addresses")
}

model Order {
  id                    BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  user_id               BigInt          @db.UnsignedBigInt
  shop_id               BigInt          @db.UnsignedBigInt
  order_number          String          @unique @db.VarChar(50)
  subtotal              Decimal         @db.Decimal(12,2)
  delivery_fee          Decimal         @db.Decimal(12,2)
  discount              Decimal         @db.Decimal(12,2)
  total                 Decimal         @db.Decimal(12,2)
  status                OrderStatus     @default(PENDING)
  payment_status        OrderPaymentStatus @default(UNPAID)
  shipping_address_id   BigInt?         @db.UnsignedBigInt
  shipping_recipient_name String?        @db.VarChar(150)
  shipping_phone        String?         @db.VarChar(30)
  shipping_city         String?         @db.VarChar(100)
  shipping_area         String?         @db.VarChar(100)
  shipping_address      String?         @db.Text
  shipping_notes        String?         @db.Text
  customer_note         String?         @db.Text
  created_at            DateTime?       @default(now()) @db.Timestamp(0)
  updated_at            DateTime?       @default(now()) @updatedAt @db.Timestamp(0)

  user      User        @relation(fields: [user_id], references: [id])
  shop      Shop        @relation(fields: [shop_id], references: [id])
  items     OrderItem[]
  payments  Payment[]
  reviews   ShopReview[]

  @@map("orders")
}

model OrderItem {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  order_id            BigInt    @db.UnsignedBigInt
  product_id          BigInt?   @db.UnsignedBigInt
  variant_id          BigInt?   @db.UnsignedBigInt
  product_name        String    @db.VarChar(200)
  product_image       String?   @db.VarChar(500)
  variant_description String?   @db.VarChar(150)
  quantity            Int       @db.UnsignedInt
  unit_price          Decimal   @db.Decimal(12,2)
  total               Decimal   @db.Decimal(12,2)
  created_at          DateTime? @default(now()) @db.Timestamp(0)

  order   Order           @relation(fields: [order_id], references: [id])
  product Product?        @relation(fields: [product_id], references: [id])
  variant ProductVariant? @relation(fields: [variant_id], references: [id])

  @@map("order_items")
}

model Payment {
  id            BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  order_id      BigInt       @db.UnsignedBigInt
  amount        Decimal      @db.Decimal(12,2)
  method        String       @db.VarChar(60)
  transaction_id String?     @db.VarChar(190)
  status        PaymentStatus @default(PENDING)
  paid_at       DateTime?    @db.DateTime(0)
  created_at    DateTime?    @default(now()) @db.Timestamp(0)
  updated_at    DateTime?    @default(now()) @updatedAt @db.Timestamp(0)

  order Order @relation(fields: [order_id], references: [id])

  @@map("payments")
}

model ShopReview {
  id         BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt      @db.UnsignedBigInt
  shop_id    BigInt      @db.UnsignedBigInt
  order_id   BigInt?     @db.UnsignedBigInt
  rating     Int         @db.UnsignedTinyInt
  comment    String?     @db.Text
  status     ReviewStatus @default(PENDING)
  created_at DateTime?   @default(now()) @db.Timestamp(0)
  updated_at DateTime?   @default(now()) @updatedAt @db.Timestamp(0)

  user  User  @relation(fields: [user_id], references: [id])
  shop  Shop  @relation(fields: [shop_id], references: [id])
  order Order? @relation(fields: [order_id], references: [id])

  @@unique([user_id, order_id], map: "uq_shop_review_user_order")
  @@map("shop_reviews")
}

model SubscriptionPlan {
  id             BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  name           String                     @db.VarChar(150)
  description    String?                    @db.Text
  price          Decimal                    @db.Decimal(12,2)
  duration       Int                        @db.UnsignedInt
  duration_unit  SubscriptionPlanDurationUnit @default(MONTH)
  features       Json?                     @db.Json
  status         Int                        @default(1)
  created_at     DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at     DateTime?                  @default(now()) @updatedAt @db.Timestamp(0)

  subscriptions ShopSubscription[]

  @@map("subscription_plans")
}

model ShopSubscription {
  id         BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  shop_id    BigInt                @db.UnsignedBigInt
  plan_id    BigInt                @db.UnsignedBigInt
  start_at   DateTime              @db.DateTime(0)
  end_at     DateTime              @db.DateTime(0)
  price      Decimal               @db.Decimal(12,2)
  status     ShopSubscriptionStatus @default(PENDING)
  created_at DateTime?             @default(now()) @db.Timestamp(0)
  updated_at DateTime?             @default(now()) @updatedAt @db.Timestamp(0)

  shop Shop @relation(fields: [shop_id], references: [id])
  plan SubscriptionPlan @relation(fields: [plan_id], references: [id])

  @@map("shop_subscriptions")
}
