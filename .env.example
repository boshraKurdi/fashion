PORT=3000
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/fashion_marketplace"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-bytes"
JWT_ACCESS_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
NODE_ENV=development
# Optional: defaults to 100 in development and 5 in production.
# AUTH_REGISTER_LIMIT=100
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Fashion Marketplace <no-reply@example.com>"
